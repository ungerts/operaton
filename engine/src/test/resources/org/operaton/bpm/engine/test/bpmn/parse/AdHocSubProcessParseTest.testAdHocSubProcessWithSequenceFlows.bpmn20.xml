<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_InvalidSequenceFlows"
                  targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:process id="InvalidSequenceFlowsProcess" name="Invalid Sequence Flows Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_ToAdHoc</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:adHocSubProcess id="AdHoc_WithSequenceFlows" name="Ad-hoc with Sequence Flows">
      <bpmn:incoming>Flow_ToAdHoc</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>

      <bpmn:userTask id="Task1" name="Task 1">
        <bpmn:outgoing>SequenceFlow_InAdHoc</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="Task2" name="Task 2">
        <bpmn:incoming>SequenceFlow_InAdHoc</bpmn:incoming>
      </bpmn:userTask>

      <bpmn:sequenceFlow id="SequenceFlow_InAdHoc" sourceRef="Task1" targetRef="Task2" />
    </bpmn:adHocSubProcess>

    <bpmn:sequenceFlow id="Flow_ToAdHoc" sourceRef="StartEvent_1" targetRef="AdHoc_WithSequenceFlows" />
    <bpmn:endEvent id="EndEvent_1">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="AdHoc_WithSequenceFlows" targetRef="EndEvent_1" />
  </bpmn:process>

</bpmn:definitions>
